# Copy to docker/.env and adjust as needed:
#   cp docker/.env.example docker/.env

# --- Database (matches data/db_config.sh defaults on the host) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=strassenraumkarte
# Host port mapped to container 5432 (db_config.sh default is 5433)
DB_HOST_PORT=5433

# --- Berlin PBF symlink source ---
# Absolute path, or path relative to the repository root.
# Default points at the sibling OSM extract used on this machine.
# Update this (or replace the file it points at), then re-run:
#   ./docker/link-berlin-pbf.sh
# That script also writes BERLIN_PBF_MOUNT (absolute path) for the tools
# container bind-mount (required: Docker does not follow host symlinks outside
# the repo mount).
BERLIN_PBF_SOURCE=../osm-processing-pipeline-comparison/data/raw/berlin-latest.osm.pbf
# BERLIN_PBF_MOUNT=  # set automatically by link-berlin-pbf.sh

# --- osm2pgsql ---
OSM2PGSQL_NUMBER_PROCESSES=8
